<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_playlist_row" android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:orientation="horizontal">
    <ImageView android:id="@+id/widget_playlist_picture" android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_playlist_name" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="0dp"
        android:maxLines="2" android:ellipsize="end" android:textColor="#182449" android:textSize="15sp" />
</LinearLayout>
