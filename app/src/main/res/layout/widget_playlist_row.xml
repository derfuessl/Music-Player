<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="42dp"
    android:paddingHorizontal="2dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/widget_playlist_picture" android:layout_width="36dp" android:layout_height="36dp"
        android:padding="2dp" android:scaleType="fitCenter" />
    <TextView android:id="@+id/widget_playlist_name" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="6dp"
        android:lines="2" android:ellipsize="end" android:textSize="14sp" />
</LinearLayout>
