<?xml version="1.0" encoding="utf-8"?>
<org.fossify.musicplayer.fragments.StopDanceFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- Scrollable on small phones/landscape; the centered column avoids oversized tablet controls. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/stop_dance_content"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <org.fossify.commons.views.MyTextView
                android:id="@+id/stop_dance_heading"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/stop_dance" android:textSize="28sp" android:textStyle="bold"
                android:accessibilityHeading="true" />
            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/stop_dance_intro" android:textSize="16sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stop_dance_status_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="24dp" android:orientation="vertical">
                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/stop_dance_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/stop_dance_connecting" android:textSize="24sp"
                        android:textStyle="bold" android:accessibilityLiveRegion="polite" />
                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/stop_dance_status_hint"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/stop_dance_source" android:textSize="16sp" />
                    <org.fossify.commons.views.MyTextView android:id="@+id/stop_dance_track"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textSize="18sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/stop_dance_previous" android:enabled="false"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="@string/dance_previous" />
                        <Button android:id="@+id/stop_dance_next" android:enabled="false"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="@string/dance_next" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/stop_dance_min_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/stop_dance_min">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/stop_dance_min_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="number"
                    android:maxLength="10"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/stop_dance_max_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/stop_dance_max">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/stop_dance_max_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="number"
                    android:maxLength="10"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/stop_dance_pause_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/stop_dance_pause">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/stop_dance_pause_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="number"
                    android:maxLength="10"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stop_dance_start"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:minHeight="56dp" android:enabled="false"
                    android:text="@string/stop_dance_start" android:textAllCaps="false" android:textSize="18sp"
                    app:cornerRadius="28dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stop_dance_stop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="16dp" android:minHeight="56dp" android:enabled="false"
                    android:text="@string/stop_dance_stop" android:textAllCaps="false" android:textSize="18sp"
                    app:cornerRadius="28dp" />
            </LinearLayout>
            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/stop_dance_stop_hint" android:textSize="14sp" />
            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/stop_dance_source" android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</org.fossify.musicplayer.fragments.StopDanceFragment>
