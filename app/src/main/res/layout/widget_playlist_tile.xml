<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_horizontal" android:orientation="vertical" android:padding="2dp">
    <ImageView android:id="@id/widget_playlist_picture" android:layout_width="80dp" android:layout_height="80dp"
        android:scaleType="centerCrop" />
    <TextView android:id="@id/widget_playlist_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="32dp" android:maxLines="2" android:ellipsize="end" android:gravity="center"
        android:textSize="14sp" android:textColor="#182449" />
</LinearLayout>
