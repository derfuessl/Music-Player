<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/widget_tile_width" android:layout_height="wrap_content" android:minHeight="84dp"
    android:gravity="center" android:orientation="vertical" android:padding="2dp">
    <ImageView android:id="@id/widget_playlist_picture" android:layout_width="40dp"
        android:layout_height="40dp" android:scaleType="fitCenter" />
    <TextView android:id="@id/widget_playlist_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:lines="2" android:ellipsize="end"
        android:gravity="center" android:textSize="12sp" />
</LinearLayout>
