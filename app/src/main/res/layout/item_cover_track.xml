<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:padding="12dp" android:minHeight="80dp" android:background="?attr/selectableItemBackground">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/cover_track_image"
        android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop"
        android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/PlaylistCoverShape" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical" android:layout_marginStart="16dp" android:orientation="vertical">
        <org.fossify.commons.views.MyTextView android:id="@+id/cover_track_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:maxLines="2" android:ellipsize="end" />
        <org.fossify.commons.views.MyTextView android:id="@+id/cover_track_artist"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:alpha="0.8" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
